# Application Settings
PROJECT_NAME="Multilingual Meeting Intelligence System"
ENVIRONMENT="development"
DEBUG=True

# API Configuration
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./meeting_intelligence.db"

# CORS Configuration (comma-separated list of origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Security & Authentication Configuration (Phase 6)
# Required in development and production environments. Must be at least 32 characters (256 bits).
# Generate a cryptographically secure key:
#   Using Python:  python -c "import secrets; print(secrets.token_hex(32))"
#   Using OpenSSL: openssl rand -hex 32
SECRET_KEY="generate-with-openssl-rand-hex-32-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Structured Meeting Intelligence Configuration (Phase 7)
# Provider options: "deterministic" (offline rule-based extractor), "ollama" (local Ollama REST API), "disabled"
INTELLIGENCE_PROVIDER="deterministic"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
LLM_MODEL_NAME="llama3.2:3b"
LLM_REQUEST_TIMEOUT_SECONDS=60.0
INTELLIGENCE_MAX_TRANSCRIPT_CHARS=40000
INTELLIGENCE_MAX_CHUNKS=50
INTELLIGENCE_OUTPUT_LANGUAGE="en"
INTELLIGENCE_MAX_RETRIES=2

# Media Retention & Lifecycle Configuration (Phase 9.4.2)
AUTO_DELETE_RAW_POST_TRANSCRIPTION=True
AUTO_DELETE_NORMALIZED_POST_TRANSCRIPTION=True
ENABLE_RETENTION_SCHEDULER=True
RETENTION_DAYS=30
RETENTION_CLEANUP_INTERVAL_SECONDS=86400.0
